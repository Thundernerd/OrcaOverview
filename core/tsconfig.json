{
  // core/ type-checks on its own (README "Self-contained core"). Bundlers that compile core's files
  // (the desktop app's electron-vite) read this file, not the root one that extends Orca's
  // generated, git-ignored .orca/types.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["*.ts"]
}
