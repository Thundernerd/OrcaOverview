{
  "name": "orca-overview-desktop",
  "productName": "Orca Overview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Orca Overview as a macOS menu bar app.",
  "license": "MIT",
  "main": "out/main/index.js",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --mac --dir",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "smoke": "node --test 'smoke/*.smoke.ts'"
  },
  "build": {
    "appId": "dev.orcaoverview.desktop",
    "productName": "Orca Overview",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "mac": {
      "target": "dir",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "Orca Overview reads the workspaces on your paired Orca servers through the orca command."
      }
    },
    "afterPack": "build/unique-uuid.cjs"
  }
}
